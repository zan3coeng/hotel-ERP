{
  "services": [
    {
      "name": "web",
      "type": "static",
      "root": "frontend",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    {
      "name": "api",
      "type": "node",
      "root": ".",
      "entrypoint": "api/index.js"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "api"
    },
    {
      "source": "/(.*)",
      "destination": "web"
    }
  ]
}
