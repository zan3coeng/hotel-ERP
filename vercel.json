{
  "services": {
    "web": {
      "root": "frontend",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": ".",
      "entrypoint": "api/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "api"
    },
    {
      "source": "/:path*",
      "destination": "web"
    }
  ]
}
